# MAX Messenger API (токен: business.max.ru → Чат-боты → Интеграция)
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_EXPECTED_USERNAME=id010505811832_bot
# После запуска cloudflared — URL для register:max-webhook
# MAX_WEBHOOK_URL=https://xxxx.trycloudflare.com/webhook/max

# AI provider: openai | openrouter
# Если не задан — используются legacy-переменные AI_API_* (обратная совместимость).
AI_PROVIDER=

# OpenAI (прямой API)
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (альтернативный провайдер)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Legacy AI (используется, если AI_PROVIDER не задан)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Администратор
ADMIN_MAX_USER_ID=
ADMIN_NAME=Оксана

# BookingLite (подключение позже)
BOOKINGLITE_API_URL=
BOOKINGLITE_API_KEY=
BOOKINGLITE_ENABLED=false

# Приложение (Timeweb App Platform задаёт PORT автоматически)
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Опционально: публичный URL для фото комнат (если используется static-server)
PHOTO_BASE_URL=
